. di "===== float vs double precision ====="
===== float vs double precision =====

. clear

. set obs 1
Number of observations (_N) was 0, now 1.

. gen float ff = 1.1

. gen double dd = 1.1

. di %21x ff
+1.19999a0000000X+000

. di %21x dd
+1.199999999999aX+000

. di ff == 1.1
0

. di dd == 1.1
1

. di float(1.1) == ff
1

. format ff %20.18f

. format dd %20.18f

. list ff dd

     +---------------------------------------------+
     |                   ff                     dd |
     |---------------------------------------------|
  1. | 1.100000023841857910   1.100000000000000089 |
     +---------------------------------------------+

