. di "counts:"
counts:

. count if x < .
  4

. count if missing(x)
  4

. count if x >= .
  4

. di "is .a > . ? " (.a > .)
is .a > . ? 1

. di "is .z > .a ? " (.z > .a)
is .z > .a ? 1

. di "is . > 1e300 ? " (. > 1e300)
is . > 1e300 ? 1

