. di "===== string functions ====="
===== string functions =====

. di length("hello")
5

. di substr("hello", 2, 3)
ell

. di upper("abc")
ABC

. di strpos("hello", "ll")
3

. di trim("  pad  ")
pad

. di subinstr("aaa", "a", "b", 2)
bba

. di strlen("héllo")
6

. di ustrlen("héllo")
5

. di ("abc" + "def")
abcdef

. di real("3.14")
3.14

. di string(3.14159, "%6.2f")
3.14

. 
. di "===== compound quotes and macros ====="
===== compound quotes and macros =====

. local a = 5

. local b "some text"

. di `a'
5

. di "`b'"
some text

. di `"nested "quoted" text"'
nested "quoted" text

. local c `"`b' more"'

. di `"`c'"'
some text more

. global g "world"

. di "hello $g"
hello world

. local n : word count one two three

. di "word count = `n'"
word count = 3

. local w : word 2 of one two three

. di "word 2 = `w'"
word 2 = two

. 
