. 
. *----------------------------------------------------------------- strl
. clear

. set obs 3
Number of observations (_N) was 0, now 3.

. gen strL big = ""
(3 missing values generated)

. replace big = "short" in 1
(1 real change made)

. replace big = "a much longer string that exceeds the usual inline threshold used by Stata for strL
>  storage, repeated to be certain: a much longer string that exceeds the usual inline threshold use
> d by Stata for strL storage" in 2
(1 real change made)

. replace big = "" in 3
(0 real changes made)

. gen str5 small = "abc"

. label data "strL fixture"

. save "strl.dta", replace
(file strl.dta not found)
file strl.dta saved

. describe

