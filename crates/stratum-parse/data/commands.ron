    // ── session and system ──────────────────────────────────────────────────
    // The working directory and the disk. These four were implemented in
    // `stratum-runtime` but absent from this table, so they parsed as UNKNOWN
    // commands: their arguments landed in a slot `cmd::slots` does not read,
    // and `cd /some/dir` silently ran as a bare `cd` (which is `pwd`) — it
    // reported the directory it had not changed to, and `cd` to a directory
    // that does not exist answered rc 0. Nothing could catch that: the unit
    // tests build their AST by hand rather than through the parser.
    ( name: "cd", abbrev: 0, slots: "REST", tier: "V1",
      help: "change directory" ),
    ( name: "pwd", abbrev: 0, slots: "REST", tier: "V1",
