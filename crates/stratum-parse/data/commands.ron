// Stratum's command table — design 02 §6.3, decision D3.
//
// This file is the SINGLE SOURCE OF TRUTH for: which words are commands, how
// far they abbreviate, which slots of the universal syntax they accept, and
// which options they take. `build.rs` compiles it into a sorted static array
// that `CommandTable::resolve` (W04, `src/cmdsig.rs`) binary-searches.
//
// FIELDS
//   name      canonical spelling. Rows are emitted sorted by this.
//   abbrev    shortest legal abbreviation. 0 = MAY NOT BE ABBREVIATED.
//   slots     VARLIST NEWVARLIST ASSIGN IF IN WEIGHT USING REST, `|`-joined.
//   weights   FWEIGHT PWEIGHT AWEIGHT IWEIGHT, `|`-joined.
//   flags     ESTIMATION BYABLE DESTRUCTIVE BLOCK_END PREFIX, `|`-joined.
//   tier      V1 (executes now) | V1_5 | V2 (parses to a signature, runs later).
//   help      one line for the completion popup, spec §22.
//   options   ( name, abbrev, arg, neg ) with arg one of
//             None Int Real Str Numlist Varlist Exprs Fmt Raw.
//
// # `abbrev` is 0 unless the value is verified
//
// A WRONG minimum makes a real abbreviation resolve to the wrong command, which
// is a silent wrong-answer bug. An absent one only makes the user type more.
// Every non-zero value below is copied from `CommandTable::core()` in W04's
// `src/cmdsig.rs`, and `tests/parse.rs::generated_table_agrees_with_core`
// asserts the two never drift — a second table that disagrees about whether `su`
// is `summarize` is exactly the failure mode D3 was chosen to avoid.
//
// # Tiers match W04's provisional table row for row
//
// `histogram`, `graph` and `twoway` are `V1_5` here because that is what W04's
// landed table says. IMPLEMENTATION_PLAN §1 lists histogram and twoway scatter
// in the Pass 1 surface; that disagreement is reported upward rather than
// resolved by whichever table was written last.

(
  commands: [

    // ── data in and out ─────────────────────────────────────────────────────
    ( name: "use", abbrev: 1, slots: "IF|IN|USING|REST", tier: "V1",
      help: "load Stata dataset",
      options: [
        ( name: "clear", abbrev: 0, arg: "None" ),
        ( name: "nolabel", abbrev: 5, arg: "None" ),
      ] ),
    ( name: "save", abbrev: 0, slots: "REST", tier: "V1",
      help: "save Stata dataset",
      options: [
        ( name: "emptyok", abbrev: 0, arg: "None" ),
        ( name: "orphans", abbrev: 0, arg: "None" ),
        ( name: "replace", abbrev: 0, arg: "None" ),
      ] ),
    ( name: "sysuse", abbrev: 0, slots: "REST", tier: "V1",
      help: "use shipped dataset",
      options: [ ( name: "clear", abbrev: 0, arg: "None" ) ] ),
    ( name: "webuse", abbrev: 0, slots: "REST", tier: "V1_5",
      help: "use dataset from Stata website",
      options: [ ( name: "clear", abbrev: 0, arg: "None" ) ] ),
    ( name: "clear", abbrev: 0, slots: "REST", flags: "DESTRUCTIVE", tier: "V1",
      help: "clear memory" ),
    ( name: "import", abbrev: 0, slots: "USING|REST", tier: "V1_5",
      help: "overview of importing data into Stata",
      options: [
        ( name: "clear", abbrev: 0, arg: "None" ),
        ( name: "delimiters", abbrev: 5, arg: "Raw" ),
        ( name: "varnames", abbrev: 0, arg: "Raw" ),
      ] ),
    ( name: "export", abbrev: 0, slots: "IF|IN|USING|REST", tier: "V1_5",
      help: "overview of exporting data from Stata",
      options: [
        ( name: "delimiters", abbrev: 5, arg: "Raw" ),
        ( name: "replace", abbrev: 0, arg: "None" ),
      ] ),
    ( name: "append", abbrev: 0, slots: "USING|REST", flags: "DESTRUCTIVE", tier: "V1_5",
      help: "append datasets",
      options: [
        ( name: "force", abbrev: 0, arg: "None" ),
        ( name: "generate", abbrev: 3, arg: "Str" ),
        ( name: "keep", abbrev: 0, arg: "Varlist" ),
        ( name: "nolabel", abbrev: 5, arg: "None" ),
      ] ),
    ( name: "merge", abbrev: 0, slots: "USING|REST", flags: "DESTRUCTIVE", tier: "V1_5",
      help: "merge datasets",
      options: [
        ( name: "assert", abbrev: 0, arg: "Raw" ),
        ( name: "force", abbrev: 0, arg: "None" ),
        ( name: "generate", abbrev: 3, arg: "Str" ),
