    "inlineResults": "editor-run",
    "docView": false,
    "commandBar": "docked-bottom",
    "theme": "system"
  },
  "windows": [
    {
      "role": "main",
      "label": "main",
      "dock": {
        "grid": {
          "root": {
            "type": "branch",
            "data": [
              {
                "type": "leaf",
                "data": {
                  "views": ["project", "variables", "sections"],
                  "activeView": "project",
                  "id": "2"
                },
                "size": 240
              },
              {
                "type": "leaf",
                "data": {
                  "views": ["editor"],
                  "activeView": "editor",
                  "id": "1"
                },
                "size": 700
              },
              {
                "type": "leaf",
                "data": {
                  "views": ["results", "graphs", "assistant"],
                  "activeView": "results",
                  "id": "3"
                },
                "size": 340
              }
            ],
            "size": 740
          },
          "width": 1280,
          "height": 740,
          "orientation": "HORIZONTAL"
        },
        "panels": {
          "editor": {
            "id": "editor",
            "contentComponent": "editor",
            "title": "Editor"
          },
          "project": {
            "id": "project",
            "contentComponent": "project",
            "title": "Project"
          },
          "variables": {
            "id": "variables",
            "contentComponent": "variables",
            "title": "Variables"
          },
          "sections": {
            "id": "sections",
            "contentComponent": "sections",
            "title": "Sections"
          },
          "results": {
            "id": "results",
            "contentComponent": "results",
            "title": "Results"
          },
          "graphs": {
            "id": "graphs",
            "contentComponent": "graphs",
            "title": "Graphs"
          },
          "assistant": {
            "id": "assistant",
            "contentComponent": "assistant",
            "title": "Assistant"
          }
        },
        "activeGroup": "3"
