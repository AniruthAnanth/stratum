{
  "schema": 1,
  "_about": "The single source of design truth (ARCHITECTURE C47 / A14). Transcribed from docs/design/06-ui-architecture.md §§14.3-14.6. `xtask tokens` generates two COMMITTED artifacts from this file and `xtask tokens --check` fails CI on drift: crates/stratum-tokens/src/generated.rs (consumed by stratum-graph, which is L1 and does no path resolution) and apps/desktop/resources/tokens.generated.css. Nothing reads this file at runtime.",
  "_conventions": [
    "Every key beginning with an underscore is documentation for a human. Generators MUST ignore them.",
    "A colour token is { value, var, use }. `value` is an uppercase 6-digit hex; `var` is the exact CSS custom-property name the frontend uses, and is authoritative because the names in 06 §14.5 are irregular (--n0, --accent, --text-body) and cannot be derived from the key.",
    "The Rust constant name for a token is SCREAMING_SNAKE_CASE of its JSON key, scoped by its parent object.",
    "`color.themes` is keyed by theme id. `light` and `dark` have identical key sets at every depth, so a generator can iterate one and index the other.",
    "Lengths are unitless numbers in CSS px unless the key ends in _ms, _s, _ch or _ratio."
  ],
  "typography": {
    "_thesis": "The typeset statistical table is the atom of the product, so the interface is designed as typesetting. Bundled woff2 only: we never fall back to a system font for anything that must align in columns.",
    "families": {
      "sans": {
        "var": "--font-sans",
        "stack": [
          "IBM Plex Sans",
          "system-ui",
          "sans-serif"
        ],
        "use": "all UI text"
      },
      "mono": {
        "var": "--font-mono",
        "stack": [
          "IBM Plex Mono",
          "ui-monospace",
          "monospace"
        ],
        "use": "editor, classic output, every numeral in a table"
      },
      "serif": {
        "var": "--font-serif",
        "stack": [
          "IBM Plex Serif",
          "Georgia",
          "serif"
        ],
        "use": "rendered narrative only"
      }
    },
    "mono_alternates": [
      {
        "name": "Iosevka Term",
        "_use": "narrower - fits 120 columns of Stata output at the same size"
      },
      {
        "name": "JetBrains Mono"
      }
    ],
    "sizes": {
      "_rule": "Six sizes, and no pane shows more than three of them.",
      "micro": {
        "var": "--fs-micro",
        "px": 11,
        "line_height_px": 14,
        "letter_spacing_em": 0.06,
        "uppercase": true,
        "use": "meta, state readout, section eyebrows"
      },
      "small": {
        "var": "--fs-small",
        "px": 12,
        "line_height_px": 16,
        "use": "table numerals in cards, dense grids, card header"
      },
      "body": {
        "var": "--fs-body",
        "px": 13,
        "line_height_px": 18,
        "use": "all UI text, labels, menus"
      },
      "code": {
        "var": "--fs-code",
        "px": 13,
        "line_height_px": 20,
        "user_min_px": 11,
        "user_max_px": 18,
        "line_height_ratio": 1.54,
        "use": "editor; size is user-adjustable, the ratio is locked"
      },
      "mid": {
        "var": "--fs-mid",
        "px": 15,
        "line_height_px": 25,
        "measure_ch": 68,
        "use": "rendered narrative (serif)"
      },
      "large": {
        "var": "--fs-large",
        "px": 18,
        "line_height_px": 24,
        "use": "modal titles and empty states only"
      }
    },
    "weights": {
      "_rule": "400, 500, 600 only. No 700 anywhere: bold headings are a dashboard tell and they fight monospace output.",
      "regular": {
        "var": "--fw-regular",
        "value": 400
      },
      "medium": {
        "var": "--fw-medium",
        "value": 500
      },
      "semibold": {
        "var": "--fw-semibold",
        "value": 600
      }
    },
    "numerals": {
      "var": "--font-numeric",
      "value": "tabular-nums lining-nums",
      "_note": "Global. Decimal alignment in result tables is text-align:right plus a per-column ch-computed padding derived from the Stata display format - never a text-align:'.' hack and never per-cell measurement."
    }
  },
  "space": {
    "_scale": "4 px base with a 2 px half-step for gutters and inline gaps.",
    "var_prefix": "--sp-",
    "steps": [
      2,
      4,
      6,
      8,
      12,
      16,
      24,
      32
    ]
  },
  "metrics": {
    "_about": "Fixed chrome heights. Density is the point.",
    "pane_header": {
      "var": "--h-pane-header",
      "px": 28
    },
    "toolbar": {
      "var": "--h-toolbar",
      "px": 32
    },
    "top_bar": {
      "var": "--h-top-bar",
      "px": 38
    },
    "status_bar": {
      "var": "--h-status-bar",
      "px": 22
    },
    "grid_row_dense": {
      "var": "--h-grid-row",
      "px": 22
    },
    "grid_row_comfortable": {
      "var": "--h-grid-row-comfortable",
      "px": 26,
      "_note": "A preference, not the default."
    },
    "gutter": {
      "var": "--w-gutter",
      "px": 18
    },
    "state_rail": {
      "var": "--w-state-rail",
      "px": 2
    },
    "card_padding_y": {
      "var": "--card-pad-y",
      "px": 8
    },
    "card_padding_x": {
      "var": "--card-pad-x",
      "px": 12
    },
    "card_gap_above": {
      "var": "--card-gap-above",
      "px": 8
    },
    "card_gap_below": {
      "var": "--card-gap-below",
      "px": 12
    },
    "hairline": {
      "var": "--hairline",
      "px": 1,
      "_note": "One border token. On >=2x displays table rules use 0.5px via transform:scaleY(.5) on a 1px pseudo-element, so a journal-weight rule is possible without blur."
    }
  },
  "radius": {
    "_rule": "Nothing above 3 px exists in the product.",
    "none": {
      "var": "--radius-none",
      "px": 0,
      "use": "panes, rules, the state rail"
    },
    "control": {
      "var": "--radius-control",
      "px": 3,
      "use": "buttons, inputs, chips, card bodies"
    }
  },
  "elevation": {
    "_rule": "Exactly two levels. Flat is everything; overlay is menus, the palette, tooltips and popovers. No result surface ever has a shadow.",
    "flat": {
      "var": "--elev-flat",
      "light": "none",
      "dark": "none"
    },
    "overlay": {
      "var": "--elev-overlay",
      "light": "0 1px 2px rgba(16,20,26,.10), 0 8px 24px rgba(16,20,26,.14)",
      "dark": "0 12px 32px rgba(0,0,0,.5)",
      "dark_outline": {
        "width_px": 1,
        "token": "border_strong"
      },
      "_note": "Dark gets a 1px --border-strong outline instead of a soft shadow, because soft shadows on dark read as smudges."
    }
  },
  "motion": {
    "_rule": "Near zero, and that is a feature. Result cards appear instantly - no fade, no slide, no height animation on first paint.",
    "state_ms": {
      "var": "--motion-state",
      "ms": 90,
      "easing": "ease-out",
      "use": "glyph state changes and hover"
    },
    "collapse_ms": {
      "var": "--motion-collapse",
      "ms": 120,
      "easing": "cubic-bezier(.2,0,0,1)",
      "use": "card collapse/expand height only"
    },
    "shuttle_s": {
      "var": "--motion-shuttle",
      "s": 2,
      "use": "indeterminate work on the 1px running hairline"
    },
    "reduced_motion": "Under prefers-reduced-motion:reduce both transitions are removed and the running hairline freezes at 50%."
  },
  "icon": {
    "grid_px": 14,
    "stroke_px": 1.25,
    "linecap": "square",
    "linejoin": "square",
    "count": 40,
    "_note": "Square caps are the deliberate difference from Feather/Lucide's round caps: they read as technical rather than friendly. No icon font, no emoji, no colour inside an icon except the six state colours."
  },
